# direnv integration, sourced (via source_env, from the package directory) by
# the consumer's packages/packages.envrc.
#
# The two exports live HERE, not in scripts/release-ivpm.yaml's `env:` block:
# ivpm emits `env:` directives only for the ROOT project, so for an installed
# dependency they are never applied. This file is what a consumer actually
# sources. See docs/plan.md, Finding 4.
PATH_add bin
# The bundled DSLX stdlib, and the libxls DSO; xlsynth-crate's build script
# links against these instead of downloading when BOTH are set (and the
# versions match -- README.md, "With xlsynth-crate").
export DSLX_STDLIB_PATH="$(expand_path share/xlsynth/dslx_stdlib)"
export XLS_DSO_PATH="$(expand_path lib/libxls.so)"
